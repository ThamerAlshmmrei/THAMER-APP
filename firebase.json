{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "thamer-e0fdd",
          "appId": "1:269361996858:android:ffc2bec54f812779784103",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "thamer-e0fdd",
          "configurations": {
            "android": "1:269361996858:android:ffc2bec54f812779784103",
            "ios": "1:269361996858:ios:7e1c1f3e908120fa784103"
          }
        }
      },
      "ios": {
        "default": {
          "projectId": "thamer-e0fdd",
          "appId": "1:269361996858:ios:7e1c1f3e908120fa784103",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      }
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5000
    },
    "firestore": {
      "port": 8081
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true,
    "storage": {
      "port": 9199
    }
  },
  "hosting": {
    "public": "docs",
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "cleanUrls": false
  }
}
